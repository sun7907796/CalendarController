{
  "name": "calendar-controller",
  "version": "1.0.0",
  "description": "桌面行事曆小工具，可編輯行程並與 Google 日曆雙向同步",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:installer": "electron-builder --win nsis -c.directories.output=dist/installer",
    "dist:portable": "electron-builder --win portable -c.directories.output=dist/portable",
    "dist": "npm run dist:installer && npm run dist:portable"
  },
  "build": {
    "appId": "com.deom.calendarcontroller",
    "productName": "CalendarController",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "google/**/*"
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CalendarController-${version}-setup.exe"
    },
    "portable": {
      "artifactName": "CalendarController-${version}-portable.exe"
    }
  },
  "dependencies": {
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
