{
  "name": "calendar-controller",
  "version": "1.2.1",
  "description": "桌面行事曆小工具（Vue3），可編輯行程並與 Google 日曆同步",
  "main": "dist/main.js",
  "scripts": {
    "build": "vite build && node scripts/build-main.js",
    "start": "npm run build && electron .",
    "dist:installer": "npm run build && electron-builder --win nsis -c.directories.output=dist-release/installer",
    "dist:portable": "npm run build && electron-builder --win portable -c.directories.output=dist-release/portable",
    "dist": "npm run dist:installer && npm run dist:portable"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.deom.calendarcontroller",
    "productName": "CalendarController",
    "files": [
      "dist/**",
      "src/build/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CalendarController-${version}-setup.exe"
    },
    "portable": {
      "artifactName": "CalendarController-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.5.2",
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "element-plus": "^2.14.2",
    "googleapis": "^144.0.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0"
  }
}
